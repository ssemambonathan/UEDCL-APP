@Composable
fun AppRoot(
    activity: FragmentActivity, 
    repo: IUedclRepository,
    selectedRegionFlow: StateFlow<String?>
) {
    val nav = remember { NavCoordinator() }
    val selectedRegion by selectedRegionFlow.collectAsState()
    val outagesFlow = remember { repo.getOutages().stateIn(CoroutineScope(Dispatchers.IO), SharingStarted.Eagerly, emptyList()) }

    // If an outage region parameter is received via push notification, auto-navigate to the Map screen
    LaunchedEffect(selectedRegion) {
        if (!selectedRegion.isNullOrEmpty()) {
            nav.current = Destination.Map
        }
    }

    Scaffold(
        bottomBar = {
            NavigationBar(containerColor = Color.White) {
                listOf(
                    Triple("Home", Icons.Default.Home, Destination.Home),
                    Triple("Buy Yaka", Icons.Default.FlashOn, Destination.BuyYaka),
                    Triple("Usage", Icons.Default.BarChart, Destination.Usage),
                    Triple("Outages", Icons.Default.Map, Destination.Map),
                    Triple("Support", Icons.Default.SupportAgent, Destination.Support)
                ).forEach { (label, icon, dest) ->
                    NavigationBarItem(
                        icon = { Icon(icon, contentDescription = label) },
                        label = { Text(label, fontSize = 11.sp) },
                        selected = nav.current == dest,
                        onClick = { nav.current = dest },
                        colors = NavigationBarItemDefaults.colors(selectedIconColor = UedclBlue, indicatorColor = UedclBlue.copy(alpha = 0.1f))
                    )
                }
            }
        }
    ) { padding ->
        Box(modifier = Modifier.fillMaxSize().padding(padding)) {
            when (nav.current) {
                Destination.Home -> HomeScreen(remember { HomeViewModel(repo) }, nav)
                Destination.BuyYaka -> BuyYakaScreen(activity, remember { YakaViewModel(repo) }) { nav.current = Destination.Home }
                Destination.Usage -> UsageScreen()
                Destination.Map -> OutageMapScreen(
                    outages = outagesFlow.collectAsState().value,
                    highlightedRegion = selectedRegion // Pass parameter into Composable screen
                )
                Destination.Support -> SupportScreen(remember { SupportViewModel(repo) })
            }
        }
    }
}
