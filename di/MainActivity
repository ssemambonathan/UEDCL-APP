 package com.uedcl.power

import android.content.Intent
import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.runtime.*
import androidx.fragment.app.FragmentActivity
import com.uedcl.power.data.local.UedclDatabase
import com.uedcl.power.data.repository.UedclRepositoryImpl
import com.uedcl.power.presentation.theme.UedclTheme
import dagger.hilt.android.AndroidEntryPoint
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow

@AndroidEntryPoint
class MainActivity : FragmentActivity() {

    // Reactive state to hold deep link parameters across recompositions
    private val _selectedRegion = MutableStateFlow<String?>(null)
    val selectedRegion = _selectedRegion.asStateFlow()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        parseNotificationExtras(intent)

        val db = UedclDatabase.getDatabase(this)
        val repo = UedclRepositoryImpl(applicationContext, db)

        setContent {
            UedclTheme {
                Surface(modifier = Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
                    AppRoot(activity = this, repo = repo, selectedRegionFlow = selectedRegion)
                }
            }
        }
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        parseNotificationExtras(intent)
    }

    private fun parseNotificationExtras(intent: Intent?) {
        val region = intent?.getStringExtra("OUTAGE_REGION")
        if (region != null) {
            _selectedRegion.value = region
        }
    }
}
