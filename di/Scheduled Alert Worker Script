const cron = require('node-cron');
const { Pool } = require('pg');
const admin = require('firebase-admin');
const serviceAccount = require('./serviceAccountKey.json');

// Initialize Firebase Admin SDK
if (!admin.apps.length) {
  admin.initializeApp({
    credential: admin.credential.cert(serviceAccount)
  });
}

// PostgreSQL Database Connection Pool
const db = new Pool({
  user: process.env.DB_USER || 'postgres',
  host: process.env.DB_HOST || 'localhost',
  database: process.env.DB_NAME || 'uedcl_power_db',
  password: process.env.DB_PASSWORD || 'secret',
  port: process.env.DB_PORT || 5432
});

const LOW_UNIT_THRESHOLD_KWH = 5.0;

/**
 * Checks all customer meters and sends push notifications for low balances.
 */
async function checkMeterBalancesAndNotify() {
  console.log(`[${new Date().toISOString()}] Starting automated meter balance check...`);

  try {
    // Query meters with balance below threshold that haven't been alerted in the last 24 hours
    const query = `
      SELECT 
        m.meter_number,
        m.available_kwh,
        u.fcm_token
      FROM meters m
      JOIN users u ON m.user_id = u.id
      WHERE m.available_kwh <= $1
        AND u.fcm_token IS NOT NULL
        AND (m.last_alert_sent_at IS NULL OR m.last_alert_sent_at < NOW() - INTERVAL '24 hours');
    `;

    const { rows: lowBalanceMeters } = await db.query(query, [LOW_UNIT_THRESHOLD_KWH]);

    if (lowBalanceMeters.length === 0) {
      console.log('No low-balance meters requiring notification at this time.');
      return;
    }

    console.log(`Found ${lowBalanceMeters.length} meter(s) requiring low unit alerts.`);

    for (const meter of lowBalanceMeters) {
      const payload = {
        token: meter.fcm_token,
        notification: {
          title: '⚡ Critical Yaka Balance',
          body: `Meter ${meter.meter_number} has only ${meter.available_kwh.toFixed(1)} kWh remaining. Recharge now to keep your power on!`
        },
        data: {
          meter_number: meter.meter_number,
          kwh_remaining: String(meter.available_kwh),
          alert_type: 'LOW_UNITS'
        },
        android: {
          priority: 'high',
          notification: {
            channelId: 'uedcl_alerts_channel',
            sound: 'default'
          }
        }
      };

      try {
        await admin.messaging().send(payload);
        console.log(`Notification dispatched successfully for meter ${meter.meter_number}`);

        // Update timestamp so we don't spam the user within 24 hours
        await db.query(
          'UPDATE meters SET last_alert_sent_at = NOW() WHERE meter_number = $1',
          [meter.meter_number]
        );
      } catch (fcmError) {
        console.error(`Failed to send push notification to meter ${meter.meter_number}:`, fcmError.message);
      }
    }
  } catch (error) {
    console.error('Error executing automated balance check cron job:', error);
  }
}

// Schedule cron job to run every 15 minutes ('*/15 * * * *')
// For testing every minute, use: '* * * * *'
cron.schedule('*/15 * * * *', () => {
  checkMeterBalancesAndNotify();
});

console.log('UEDCL Automated Low-Unit Notification Cron Service Started.');
